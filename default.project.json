{
  "name": "Swarm",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "GameServer": {
        "$path": "src/server/GameServer.server.lua"
      },
      "Modules": {
        "$path": "src/server/Modules"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CharacterJumpPower": 0,
        "CharacterUseJumpPower": true,
        "LoadCharacterAppearance": false,
        "EnableMouseLockOption": false,
        "CameraMaxZoomDistance": 120,
        "CameraMinZoomDistance": 10,
        "DevTouchMovementMode": "Scriptable",
        "DevComputerMovementMode": "Scriptable"
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "SwarmClient": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false,
        "Gravity": 196.2,
        "FallenPartsDestroyHeight": -200
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2.5,
        "GlobalShadows": true,
        "Ambient": [0.4, 0.4, 0.42],
        "OutdoorAmbient": [0.55, 0.55, 0.55]
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}

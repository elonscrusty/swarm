end

DRAW.SunMedallion = function(c)
	for k = 0, 7 do
		local a = k * 45
		local r = math.rad(a)
		box(c, 12 + math.cos(r) * 8.6, 12 + math.sin(r) * 8.6, 4, 2.6, c.accent, a, 1.3)
	end
	dot(c, 12, 12, 6.6, c.main)
	ring(c, 12, 12, 4.4, 1.1, c.mono and c.back or c.extra)

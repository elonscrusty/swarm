DRAW.Heartseeker = function(c)
	crossbowIcon(c, c.mono and c.main or P.crimson_700, c.main, c.extra)
	for _, dx in ipairs({ -5, 5 }) do
		seg(c, 12 + dx, 2.4, 12 + dx * 0.7, 5.6, 1, c.extra, 0.3)
	end

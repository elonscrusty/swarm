		gear(rig.Torso, rig.Model, { Name = "QuiverRim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.14, 0.66, 0.66), Color = c.Gold, Material = METAL }, quiver * CFrame.new(0, 1.0, 0) * UP)

	anim("Cylinder", P.ice_300, SMOOTH, flatDisc(x, z, 0.12), nil, Vector3.new(0.04, d * 0.5, d * 0.5), Vector3.new(0.04, d * 1.05, d * 1.05), 0.3, 1, 0.45)

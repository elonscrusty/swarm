	local holder = new("Frame", { Name = "Plate", BackgroundTransparency = 1, Active = false }, frame)
	ui.Plate = holder
	local body, face = goldSurface(holder, "Body", Theme.Radius.L, UDim2.fromOffset(VIT.W, VIT.H))

		anim("Wedge", (i % 2 == 0) and P.crimson_500 or P.crimson_600, SMOOTH, base, base + Vector3.new(0, h * 0.95, 0), Vector3.new(0.6, h, 0.9), nil, 0, 1, 0.5)

	anim("Cylinder", P.amber_300, SMOOTH, flatDisc(x, z, 0.1), nil, Vector3.new(0.04, 1, 1), Vector3.new(0.04, r * 2.4, r * 2.4), 0.4, 1, 0.35)
end


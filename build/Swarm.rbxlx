			gear(arm, rig.Model, { Name = "PauldronRim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 1.55, 1.45), Color = c.Gold, Material = METAL }, CFrame.new(s * 0.06, 0.5, 0) * UP)

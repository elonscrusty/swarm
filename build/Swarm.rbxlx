	drop(c, 17.4, 14, 1.9, c.extra)
	drop(c, 12, 14.8, 6.4, c.extra)
	drop(c, 12, 16.2, 4.6, c.mono and c.back or c.main)
	drop(c, 12, 17.6, 2.6, c.mono and c.main or c.accent)

DRAW.ThunderLoop = function(c)
	ring(c, 12, 12, 9.6, 1.8, c.extra, 0.15)
	local bolt = { V(13.8, 4.6), V(9.2, 12.4), V(13.6, 12.4), V(9.8, 19.4) }
	if not c.mono then
		line(c, bolt, 5, c.extra, false, 0.8)
	end
	line(c, bolt, 2.8, c.main)

end

DRAW.VolatileSpore = function(c)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		seg(c, 12 + math.cos(a) * 8.4, 12 + math.sin(a) * 8.4, 12 + math.cos(a) * 10.6, 12 + math.sin(a) * 10.6, 1.4, c.accent)
	end

		local to = Vector3.new(x + math.cos(a) * r, FLOOR_Y + 0.4 + math.random() * 2, z + math.sin(a) * r)
		anim("Ball", (i % 2 == 0) and P.gold_200 or P.moth_glow, NEON, CFrame.new(from), CFrame.new(to), Vector3.one * 0.45, Vector3.one * 0.15, 0, 1, 0.45)

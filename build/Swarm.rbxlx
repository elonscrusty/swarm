		gear(rig.Torso, rig.Model, { Name = "Scarf", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.45, 2.45, 2.2), Color = c.Accent }, CFrame.new(0, 0.92, 0) * UP)

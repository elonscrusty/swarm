			HatAccent = Palette.ivory_100,
		},
		Hat = "Bandana",
	},
	Rogue_Ninja = {
		Id = "Rogue_Ninja",
		Name = "Ninja",
		Character = "Rogue",
		Pass = "Skin",
		Colors = {
			Metal = Palette.stone_800,
			Cloth = Palette.chitin_900,
			Cloth2 = Palette.chitin_800,
			Accent = Palette.crimson_500,

	box(c, x, y + 4.6 * s, 6 * s, 3.4 * s, bone, 0, 1.2 * s)
	dot(c, x - 2.1 * s, y + 0.2 * s, 1.5 * s, c.mono and c.back or glow)
	dot(c, x + 2.1 * s, y + 0.2 * s, 1.5 * s, c.mono and c.back or glow)

	Windstep = 90894200102391,
	WispChoir = 134215168328609,
	Worldbreaker = 94880898338591,
} :: { [string]: (number | string)? }

-- Last-resort text (1-2 letters) for an id that has neither a picture nor a vector icon.
IconData.Glyphs = {
	Whip = "Sw",
	MagicOrb = "Or",
	Knives = "Kn",
	Garlic = "Ga",
	HolyWater = "HW",
	Lightning = "Lt",
	Axe = "Ax",

		gear(ra, rig.Model, { Name = "StaffCrystal", Size = Vector3.new(0.3, 0.42, 0.3), Color = Palette.fx_arcane, Material = Enum.Material.Neon }, CFrame.new(0.15, 3.0, -0.25) * CFrame.Angles(0, math.rad(45), 0))
	end,

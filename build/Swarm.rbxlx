		anim("Block", (i % 3 == 0) and P.gold_400 or P.ivory_200, SMOOTH, CFrame.new(from), CFrame.new(to) * CFrame.Angles(math.random() * 4, 0, math.random() * 4), Vector3.new(0.8, 0.14, 0.7), Vector3.new(0.5, 0.1, 0.4), 0, 1, 0.45, 1.5)

	anim("Cylinder", P.amber_300, SMOOTH, flatDisc(x, z, 0.14), nil, Vector3.new(0.04, d * 0.3, d * 0.3), Vector3.new(0.04, d * 1.1, d * 1.1), 0.2, 1, 0.35)

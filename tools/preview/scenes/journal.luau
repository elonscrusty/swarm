-- Manual journal with one observed drop and one encountered boss.
local C = lib("common")
C.lobby()
C.startClient()
C.sendProfile(C.profile({ Journal = { Enemies = { Slime = true, Boss = true }, Drops = { Slime = { XP = true }, Boss = { XP = true, Chest = true } } } }))
C.settle(1)
C.fire("OpenPanel", "Stats")
C.settle(1)
local tabs = preview.findGui(function(g) return g:IsA("GuiButton") and g.Name == "JOURNAL" and preview.isShown(g) end)
assert(tabs[1], "Stats must expose Journal tab")
preview.click(tabs[1])
C.settle(2)
local shown = preview.findGui(function(g) return g:IsA("Frame") and g.Name == "Journal" and g.Parent.Name == "Screens" and preview.isShown(g) end)
assert(shown[1], "Stats Journal tab must open Journal screen")
preview.log("PASS real Stats-to-Journal navigation")
